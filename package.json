{
  "name": "a-hairline-crack-mcp",
  "description": "Private MCP gateway for the A Hairline Crack project",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run",
    "test:read-reliability": "node --experimental-strip-types --test test/read-reliability.test.mjs",
    "test:batch-read": "node --experimental-strip-types --test test/batch-read.test.mjs test/single-flight.test.mjs",
    "test:unit": "node --experimental-strip-types --test test/read-reliability.test.mjs test/batch-read.test.mjs test/single-flight.test.mjs",
    "check": "npm run test:unit && wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260729.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.115.0"
  }
}
